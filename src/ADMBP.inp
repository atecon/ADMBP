function scalar ardl_lagselect (const series y,
                                 const list xlist,
                                 const list rxlist,
                                 const int max_lag[2::],
                                 string lag_criteria,
                                 const bool verbose[FALSE])
    /* Retrieve optimal lag-length by means of some information lag_criteria. */

    # TODO: make use of "criteria" package which includes AICc

    string lag_criteria = toupper(lag_criteria)
    string opt_silent = verbose == FALSE ? "--silent" : "--quiet"

    # Prepare lags
    list xlist_lags = xlist(-1 to -max_lag)
    list Xall = xlist_lags rxlist

    var max_lag y ; Xall --lagselect @opt_silent
    scalar opt_lag = iminc($test[,3 + get_lagselect_criteria_id(lag_criteria)])

    return opt_lag
end function


function scalar get_lagselect_criteria_id (const string lag_criteria)
    /* Retrieve the ID of the lag selection criteria. */

    bundle Map = _(AIC = 1, BIC = 2, HQC = 3)
    return Map[lag_criteria]
end function


function scalar model_is_stable (matrix ARcoef)
  /* Check for dynamic stability.
  return: 1 if stable, otherwise 0. */

  matrix ARcoef = vec(ARcoef)
  scalar value = 1 - sumc(ARcoef)

  if -value < -0.00001
      return TRUE
  else
      return FALSE
  endif
end function

function bundle get_defaults (void)
    /* Default parameter values for ARDL estimation. */

    bundle self = empty
    scalar self.max_lag = $pd
    string self.lag_criteria = ""  # per default no lag selection
    scalar self.conditional_model = FALSE
    scalar self.cumulated_multipliers = FALSE
    scalar self.max_horizon = 12
    # "parametric", "non_parametric", "wild_uniform", "wild_rademacher", "block"
    string self.boot_type = "block"
    scalar self.boot_reps = 999
    #scalar self.cilevel = 0.95  # TODO: I think this is not needed anymore
    scalar self.verbose = FALSE
    scalar self.stopping_criteria = 0.2
    # CASES: "nc": no const., "uc": unrestricted const., "rc": restricted const.,
    # "crt": unrest. const + restr. trend, "ct": unrest. const + unrestr. trend
    # This is following gretl's vecm command.
    string self.det_case = "uc"
    scalar self.error = FALSE

    return self
end function

function string get_shocktype (const int cumulated_multipliers)
    /* Get shock type. */
    string shocktype = (cumulated_multipliers == 0) ? "temporary" : "permanent"
    return shocktype
end function

function string get_bootstrap_type (const string boot_type)
    /* Get bootstrap type as full string. */

    if boot_type == "parametric"
        string ret = "parametric"
    elif boot_type == "non-parametric"
        string ret = "non-parametric"
    elif boot_type == "wild-uniform"
        string ret = "wild (uniform)"
    elif boot_type == "wild-rademacher"
        string ret = "wild (Rademacher)"
    elif boot_type == "block"
        string ret = "block-bootstrap"
    endif

    return ret
end function


function void missings_exist (const list All)
    /* Check for sample validity. */

    scalar nobs = $nobs
    smpl All --no-missing
    scalar nobs_new = $nobs

    errorif(nobs != nobs_new,
            "Error: Missing values in the sample. Please remove them and try again.")
end function

function void add_varnames (bundle *self,
                            const list xlist,
                            const list rxlist)
    /* Add variable names to the bundle. */

    self.vname_xlist = varnames(xlist)
    self.vname_rxlist = varnames(rxlist)
end function


function bundle est_ardl (const series target "Endogenous in levels",
                          const list xlist "Exogenous in levels (lags autom. created)",
                          list rxlist[null] "Exogenous in levels (no lags created)",
                          bundle self[null])
    /* Compute ARDL model regression and dynamic multipliers */

    if exists(self)
        bundle self = self + get_defaults()
    else
        bundle self = get_defaults()
    endif
    add_varnames(&self, xlist, rxlist)
    self.vname_target = argname(target)

    list xlist_w_lags = get_lags(xlist, self.max_lag, self.conditional_model)

    # TODO: in principle we could internally manage missings, but I think the user
    # should be aware of this and remove them before calling setARDL()
    smpl +self.max_lag ;
    list All = target xlist_w_lags rxlist
    missings_exist(All)
    self.T = $nobs
    self.t1 = $t1
    self.t2 = $t2

    scalar self.optimal_lag = self.max_lag  # default value
    if self.lag_criteria != ""
        if self.verbose
            printf "Start lag selection using %s...\n", self.lag_criteria
        endif

        scalar self.optimal_lag = ardl_lagselect(target, xlist, rxlist,
                                             self.max_lag, self.lag_criteria,
                                             self.verbose)
        if self.verbose
            printf "\nOptimal lag length (%s): %d\n", self.lag_criteria, self.optimal_lag
        endif

        # Update xlist with optimal lags
        list xlist_w_lags = get_lags(xlist, self.optimal_lag, self.conditional_model)
    endif

    # Estimate the initial ARDL model
    scalar SPECIFICATION_TESTS = TRUE
    bundle self.Model = estimate_var(target, xlist_w_lags, rxlist, self, SPECIFICATION_TESTS)
    matrix self.Model.ar_coefficients = get_ar_coefficients(self.Model)
    scalar model_is_stable = model_is_stable(self.Model.ar_coefficients)
    errorif(!model_is_stable, "Error: The model is unstable. Re-specify your model and try again.")

    # Retrieve point estimates of the ARDL model
    matrix self.Model.xlist_coefficients = get_xlist_coefficients(self.Model, xlist_w_lags,
                                                                  self.vname_xlist)
    matrix self.Model.rxlist_coefficients = get_rxlist_coefficients(self.Model, rxlist)
    # Currently, only "const" is included in the deterministic
    # e.g. "time" is part of rxlist
    matrix self.Model.deterministic_coefficients = get_deterministic_coefficients(self.Model)

    # Compute and store multipliers using point estimates
    matrices self.DynamicMultipliers = get_dynamic_multipliers(self, self.Model, 0)
    matrix coeff_longrun = get_longrun_multipliers(self, self.Model, 0)
    matrix self.coeff_longrun = coeff_longrun[,1]
    rnameset(self.coeff_longrun, rnameget(coeff_longrun))
    cnameset(self.coeff_longrun, "Coeff.(asym)")
    matrix self.stderr_longrun = coeff_longrun[,2]
    rnameset(self.stderr_longrun, rnameget(coeff_longrun))
    cnameset(self.stderr_longrun, "S.E.(asym)")

    smpl full
    if self.boot_reps > 0               # Bootstrap estimation
        bundle ModelBoot = bootARDL(target, xlist, rxlist, self, self.Model)

        # Compute and store bootstrap dynamic multipliers
        matrices self.multipliers_boot = get_dynamic_multipliers(self, ModelBoot, self.boot_reps)
        # We do not compute summary statistics for the bootstrapped dynamic multipliers here

        # Compute and store long-run multiplier results
        matrix ModelBoot.LongRunMultipliers = get_longrun_multipliers(self, ModelBoot, self.boot_reps)
        # Store long-run multiplier results
        matrix coeff_longrun = eval_boot_longrun_multipliers(self, ModelBoot.LongRunMultipliers)
        matrix self.coeff_longrun_boot = coeff_longrun[,1:2]  # retrieve mean and median
        cnameset(self.coeff_longrun_boot, cnameget(coeff_longrun)[1:2])
        rnameset(self.coeff_longrun_boot, rnameget(coeff_longrun))
        matrix self.stderr_longrun_boot = coeff_longrun[,3] # retrieve standard error
        rnameset(self.stderr_longrun_boot, rnameget(coeff_longrun))
        cnameset(self.stderr_longrun_boot, "S.E.(boot)")
    endif

    return self
end function


function matrix get_mean_lags (const bundle Model)
    /* Get the mean lag of all variables.
       Kudos to Jack for this code.  */
    # TODO: In principle, this could also be done for the bootstrapped model estimates

    scalar nX = cols(Model.Model.xlist_coefficients)
    matrix avec = Model.Model.ar_coefficients
    scalar sum_avec = 1 - sumc(avec)
    scalar p = rows(avec)
    scalar q = p - 1           # TODO: check if this is correct

    matrix mean_lags = mshape(NA, nX, 1)

    loop i=1..nX
        matrix bvec = Model.Model.xlist_coefficients[,i]
        sum_bvec = sumc(bvec)

        if p > 0
            sda = -seq(1, p) * avec
        else
            sda = 0
        endif
        if q > 0
            sdb = seq(1, q) * bvec[2:]
        else
            sdb = 0
        endif

        mean_lags[i] = sdb/sum_bvec - sda/sum_avec
    endloop

    cnameset(mean_lags, defarray("Mean lag"))
    rnameset(mean_lags, Model.vname_xlist)

    return mean_lags
end function



function void print_error_failed_attempts (const int nfailed_estimates,
                                           const int boot_reps)
    /* code description
    return: type, description */

    scalar pct_failed = 100 * nfailed_estimates / boot_reps
    printf "\nError: %d pct. of the bootstrap iterations failed due to instability.\n", pct_failed
    print "Error: Please re-specify your model and try again."
end function

function matrix build_xzbeta_coeff_vector (const bundle self)
    /* Build the coefficient vector for the xz terms. Needed for bootstrapping part. */

    matrix ret = vec(self.deterministic_coefficients) | \
                 vec(self.xlist_coefficients) | \
                 vec(self.rxlist_coefficients)

    return ret
end function


function matrix get_cov_matrix (const bundle Model, const int max_lag, const int selected_xvar)
    #' Retrieve the covariance matrix for the target terms and selected x variable.
    #'
    #' @param self A bundle containing the model information.
    #' @param selected_xvar An integer representing the selected x variable.
    #' @return A matrix representing the covariance matrix for the target terms and selected x variable.
    #'
    #' This function extracts the relevant entries from the variance-covariance (vcv) matrix
    #' of the model coefficients. It creates a mask to select the appropriate rows and columns
    #' corresponding to the y terms and the specified x variable (if any). The resulting matrix
    #' is the covariance matrix for these terms.

    matrix vcv = Model.xtxinv
    scalar n_deterministics = sum(Model.detflags)
    matrix mask = zeros(Model.ncoeff)

    # Set the mask for y terms
    scalar start_y = 1 + n_deterministics
    scalar ende_y = start_y + max_lag - 1
    mask[start_y:ende_y] = 1

    if selected_xvar != 0
        # Set the mask for the x terms
        scalar start_x = ende_y + 1 + (selected_xvar - 1) * max_lag
        scalar ende_x = start_x + max_lag - 1
        mask[start_x:ende_x] = 1
    endif

    # Select the rows and columns of the vcv matrix
    matrix ret = selifr(vcv, mask)
    ret = selifc(ret, mask')

    return ret
end function

function list list_of_deterministics (const matrix detflags)
    /* Return list of deterministics. */

    list L = empty
    if sum(detflags) == 0
        return L
    elif sum(detflags) == 1
        L += const
    elif sum(detflags) == 2
        L += const time
    else
        errorif(TRUE, "Currently only const and time are supported as deterministics.")
    endif

    return L
end function

function matrix get_deterministic_coefficients (const bundle Model)
    /* Get coefficients of deterministic terms. */

    matrix coeffs = empty

    scalar n_deterministics = sum(Model.detflags)
    if n_deterministics == 0
        return coeffs
    endif
    matrix coeffs = Model.coeff[1:n_deterministics]

    return coeffs
end function

function matrix get_rxlist_coefficients (const bundle Model,
                                         const list rxlist "Exogenous in levels (no lags created)")
    /* Get coefficients of exogenous variables for which we do not create lags, e.g. dummies, time trend. */

    matrix coeffs = empty
    if nelem(rxlist) == 0
        return coeffs
    endif

    scalar start = nelem(Model.coeff) - nelem(rxlist) + 1
    matrix coeffs = Model.coeff[start:]
    errorif(nelem(coeffs) != nelem(rxlist), "Error: Number of coefficients does not match number of exogenous variables.")

    return coeffs
end function

function matrix get_xlist_coefficients (const bundle Model,
                                        const list xlist_w_lags "Exogenous in levels with lags",
                                        const strings vnames)
    /* Get coefficients of exogenous variables for which we create lags.
     The returned matrix has the following structure:
     - Each column represents a variable in xlist_w_lags.
     - Each row represents the coefficients of the respective variable.
     - Each row corresponds to a lag of the respective variable. */

    matrix coeffs = empty

    if nelem(xlist_w_lags) == 0
        return coeffs
    endif

    scalar n_deterministics = sum(Model.detflags)
    scalar start = 1 + n_deterministics + Model.order  # skip deterministics + AR coefficients
    scalar n_xlist_w_lags = nelem(xlist_w_lags)
    scalar ende = start + n_xlist_w_lags - 1
    matrix coeffs = Model.coeff[start:ende]

    coeffs = mshape(coeffs, Model.order, nelem(vnames))
    cnameset(coeffs, vnames)

    return coeffs
end function

function matrix get_ar_coefficients (const bundle Model)
    /* Get AR coefficients. Note: we assume there exist AR-coeffients */
    return vec(Model.A[1,])
end function

function bundle collect_post_est_info (const bundle Model)

    bundle self = empty
    matrix self.ar_coefficients = Model.A[1,]'
    matrix self.uhat = Model.uhat

end function

function list get_lags (const list xlist, const scalar max_lag, const scalar conditional_model)
    /* Create lags for exogenous variables. */

    scalar pqmin = (conditional_model == 1) ? 0 : 1
    list xlist_with_lags = xlist(-pqmin to -max_lag)

    return xlist_with_lags
end function

function bundle estimate_var (const series target "Endogenous in levels",
                              const list xlist "Exogenous in levels",
                              list rxlist[null] "Restricted I0s excl. intercept",
                              const bundle self,
                              const bool dotests)
    /* Estimate a 1-dimensional VARX model. */

    list Exog = xlist rxlist
    string quiet_opt = self.verbose == FALSE ? "--silent" : ""
    string pdstring = sprintf("%d", $pd)

    # TODO: add further options for VARX estimation such as the deterministics
    # see "help var"
    var self.optimal_lag target ; xlist rxlist @quiet_opt
    bundle Model = $system

    if dotests
        modtest @pdstring --autocorr --silent
        matrix Model.autocorr_test = $test
        matrix Model.autocorr_pvalue = $pvalue
        modtest @pdstring --arch --silent
        matrix Model.arch_test = $test
        matrix Model.arch_pvalue = $pvalue
        scalar Model.rsq = get_rsq(target, Model.uhat[,1])
        scalar Model.rsq_adj = get_adjusted_rsq(Model.rsq, Model.T, Model.df)
    endif

    return Model
end function


function matrix get_model_statistics (const bundle Model)
    #' This function takes a bundle containing model statistics and returns a matrix
    #' with selected statistics including R-squared, adjusted R-squared, and p-values
    #' for autocorrelation and ARCH tests.
    #'
    #' @param Model A bundle containing model statistics.
    #' @return A matrix with the following statistics:
    #'   - R-squared
    #'   - Adjusted R-squared
    #'   - P-value for autocorrelation test at lag 1
    #'   - P-value for autocorrelation test at lag specified by $pd
    #'   - P-value for ARCH test at lag 1
    #'   - P-value for ARCH test at lag specified by $pd
    #'
    #' The matrix will have row names corresponding to the labels of the statistics.

    string pdstring = sprintf("%d", $pd)
    matrix table = Model.rsq | Model.rsq_adj
    table |= Model.autocorr_pvalue[1]  # lag 1
    if $pd > 1
        table |= Model.autocorr_pvalue[$pd]  # lag $pd
    endif
    table |= Model.arch_pvalue[1]  # lag 1
    if $pd > 1
        table |= Model.arch_pvalue[$pd]  # lag $pd
    endif

    # Prepare row-labels
    strings rlabels = defarray("R-squared", "Adj. R-squared", "P-value SC(1)")
    if $pd > 1
        rlabels += sprintf("P-value SC(%d)", $pd)
    endif
    rlabels += "P-value ARCH(1)"
    if $pd > 1
        rlabels += sprintf("P-value ARCH(%d)", $pd)
    endif
    rnameset(table, rlabels)

    return table
end function

function matrix compute_dynamic_multipliers (const matrix ar_coeff,
                                             const matrix x_coeff,
                                             const int max_horizon[1::],
                                             const bool cumulated_multipliers)
    /* Compute dynamic multipliers.
       Kudos to Jack for this code.  */

    # TODO: instead of a unit-shock, shocksize could equal the standard deviation
    # of the shock variable -- not of the target series
    matrix shock = 1 | zeros(max_horizon, 1)
    shock = cumulated_multipliers ? cum(shock) : shock
    matrix dyn_mult = filter(shock, x_coeff, ar_coeff)

    return dyn_mult
end function


function matrices get_dynamic_multipliers (const bundle self,
                                           const bundle Model,
                                           int boot_reps[0::])
    /* Compute dynamic multipliers for target and all xlist series. */

    if self.verbose
        print "Start computing dynamic multipliers "
        if boot_reps > 0
            printf "with %d bootstrap iterations...\n", boot_reps
        endif
    endif

    scalar boot_reps = boot_reps == 0 ? 1 : boot_reps    # set to 1 if no bootstrapping
    scalar nvars_yx = 1 + nelem(self.vname_xlist)
    scalar nrows = (1+self.max_horizon)
    # store results for each shock in a separate matrix
    matrices DynamicMultipliers = array(nvars_yx)

    loop i=1..nvars_yx
        DynamicMultipliers[i] = mshape(NA, nrows, boot_reps)
        matrix xbeta = {}

        loop j=1..boot_reps
            if boot_reps > 1
                matrix arcoeff = Model.ar_coefficients[j,]
            else
                matrix arcoeff = Model.ar_coefficients
            endif

            if i > 1  # for i==1 for the target variable we do not need xbeta

                if boot_reps > 1
                    # Retrieve lag-coefficients for the selected x variable
                    matrix xbeta = Model.xlist_coefficients[j,]
                    xbeta = mshape(xbeta, self.optimal_lag, nelem(self.vname_xlist))
                    xbeta = xbeta[,i-1]  # coefficient vector for the selected x variable
                else
                    matrix xbeta = Model.xlist_coefficients[,i-1]
                endif
            endif

            DynamicMultipliers[i][,j] = compute_dynamic_multipliers(arcoeff, xbeta,
                                            self.max_horizon,
                                            self.cumulated_multipliers)
        endloop
    endloop

    if self.verbose
        if boot_reps == 1
            printf "Succesfully computed dynamic multipliers...\n"
        else
            printf "Succesfully computed dynamic multipliers with b=%d...\n", boot_reps
        endif
    endif

    return DynamicMultipliers
end function


function matrix get_longrun_multipliers (const bundle self,
                                         const bundle Model,
                                         int boot_reps[0::])
    #' Function to compute long-run multipliers for a given model.
    #'
    #' @param self A bundle containing the model specification and data.
    #' @param Model A bundle containing the estimated model coefficients.
    #' @param boot_reps An integer specifying the number of bootstrap replications. Default is 1 (no bootstrapping).
    #' @return A matrix of long-run multipliers. If boot_reps > 1, the matrix contains the multipliers for each bootstrap replication.
    #'         Otherwise, the matrix contains the coefficients and their standard errors.
    #'
    #' This function computes the long-run multipliers for each variable in the target and xlist. If bootstrapping is requested,
    #' it stores the results for each shock in a separate matrix. Otherwise, it computes the coefficients and standard errors.
    #' The function loops over all variables and bootstrap replications, retrieves the necessary coefficients, and computes the
    #' long-run multipliers using the `compute_longrun_multiplier` function.

    if self.verbose
        print "Start computing long-run multipliers "
        if boot_reps > 0
            printf "with %d bootstrap iterations...\n", boot_reps
        endif
    endif

    scalar boot_reps = boot_reps == 0 ? 1 : boot_reps    # set to 1 if no bootstrapping
    # Loop over all variables in target + xlist
    scalar nvars_yx = 1 + nelem(self.vname_xlist)

    if boot_reps > 1
        # store results for each shock in a separate matrix
        matrix LongRunMultipliers = mshape(NA, boot_reps, nvars_yx)
    else
        matrix LongRunMultipliers = mshape(NA, nvars_yx, 2)  # store coefficients and standard errors
    endif

    loop i=1..nvars_yx
        matrix xbeta = {}

        loop j=1..boot_reps
            if boot_reps > 1
                matrix arbeta = Model.ar_coefficients[j,]
                # not interested in computing standard errors via the Delta method
                # as these are computed by bootstrapping instead
                matrix vcv = {}
            else
                matrix arbeta = Model.ar_coefficients
                matrix select = i == 1 ? 0 : (i-1)  # 1st round, select no xlist-variable
                matrix vcv = get_cov_matrix(Model, self.optimal_lag, select)
            endif

            if i > 1  # for i==1 for the target variable we do not need xbeta
                matrix xbeta = Model.xlist_coefficients[,i-1]

                if boot_reps > 1
                    # Retrieve lag-coefficients for the selected x variable
                    matrix xbeta = Model.xlist_coefficients[j,]
                    xbeta = mshape(xbeta, self.optimal_lag, nelem(self.vname_xlist))
                    xbeta = xbeta[,i-1]  # coefficient vector for the selected x variable
                else
                    matrix xbeta = Model.xlist_coefficients[,i-1]
                endif
            endif

            if boot_reps > 1
                LongRunMultipliers[j,i] = compute_longrun_multiplier(arbeta, xbeta, vcv)[,1] # only coefficient
            else
                LongRunMultipliers[i,] = compute_longrun_multiplier(arbeta, xbeta, vcv)
            endif
        endloop
    endloop

    label_vnames = defarray(self.vname_target) + self.vname_xlist
    if boot_reps > 1
        cnameset(LongRunMultipliers, label_vnames)
    else
        rnameset(LongRunMultipliers, label_vnames)
        cnameset(LongRunMultipliers, defarray("Coeff.", "S.E."))
    endif

    if self.verbose
        if boot_reps == 1
            printf "Succesfully computed long-run multipliers...\n"
        else
            printf "Succesfully computed long-run multipliers with b=%d bootstrap iterations.\n", boot_reps
        endif
    endif

    return LongRunMultipliers
end function


function matrix compute_longrun_multiplier (const matrix ar_coefficients,
                                            const matrix x_coefficients,
                                            const matrix vcv)
    /* Compute long-run multipliers. Both matrices are column vectors and represen
      the lag of the AR terms and the i-th exogenous, respectively.
      If vcv has non-zero elements, the standard error is computed by the Delta method.
      Kudos to Jack for the original code this is built on.  */

    scalar ny = nelem(ar_coefficients)
    scalar nx = nelem(x_coefficients)
    scalar ncoeff = ny + nx

    scalar no_distlags = nx == 0
    scalar no_ar = ny == 0
    scalar denominator = no_ar ? 1 : 1 - sum(ar_coefficients)
    scalar lrbeta = no_distlags ? 1 / denominator : sum(x_coefficients) / denominator
    scalar se = NA

    if nelem(vcv)
        # Jacobian term for computing the standard error by delta method
        # FIXME: I am not sure how to implement this currently
        if nelem(vcv) == 0
            return {lrbeta, NA}
        endif
        matrix J = zeros(1, ncoeff)
        if !no_ar
            J[1:ny] = lrbeta / denominator
        endif
        if !no_distlags
            J[ny+1:] = 1 / denominator
        endif

        scalar se = sqrt(qform(J, vcv))
    endif

    return {lrbeta, se}
end function



function series generate_bootstrap_residuals (const series uhat, const string boot_type)
    #' Function to generate bootstrap residuals based on the specified bootstrap type.
    #'
    #' @param uhat A series representing the residuals from a regression model.
    #' @param boot_type A string indicating the type of bootstrap to perform.
    #'                  Options include:
    #'                  - "parametric": Generates residuals from a normal distribution with mean 0 and standard deviation equal to the standard deviation of uhat.
    #'                  - "non_parametric": Generates residuals by resampling from the provided residuals (uhat).
    #'                  - "wild_uniform": Generates residuals by resampling from uhat and multiplying by a uniform(0,1) random variable.
    #'                  - "wild_rademacher": Generates residuals by resampling from uhat and multiplying by a Rademacher random variable (-1 or 1).
    #'                  - "block": Generates residuals using a block bootstrap method.
    #'
    #' @return A series representing the generated bootstrap residuals.

    #uhat = uhat-mean(uhat)	# TODO: is re-centering needed here??

    if boot_type == "parametric"
        series e = normal(0, sd(uhat))	     # parametric bootstrap
    elif boot_type == "non_parametric"
        # draw from estimated residuals by resampling
        # (may suffer from serial correl.)
        series e = resample(uhat)
    elif boot_type == "wild_uniform"	# wild uniform
        series e = resample(uhat) * uniform(0,1)
    elif boot_type == "wild_rademacher"
        # Use Rademacher distri instead of uniform(0,1)
        series Rad = uniform(0,1)
        Rad = -1 * (Rad <= 0.5) + (Rad > 0.5)
        series e = resample(uhat) * Rad
    elif boot_type == "block"						# block bootstrap
        series e = SB({uhat}, 0)
    endif

    return e
end function


function bundle bootARDL (const series target,
                          const list xlist,
                          list rxlist[null],
                          const bundle self,
                          const bundle Model)
    /* Bootsrap estimation. */

    bundle ModelBoot = empty

    if self.verbose
        print "Start setting up objects for storing bootstrap results..."
    endif

    # We are going to store all coefficients of the VAR model
    #matrix ModelBoot.coeff_boot = mshape(NA, self.boot_reps, self.Model.ncoeff)
    matrix ModelBoot.ar_coefficients = mshape(NA, self.boot_reps, Model.order)
    matrix ModelBoot.xlist_coefficients = mshape(NA, self.boot_reps,
                                                 Model.order * nelem(xlist))
    matrix ModelBoot.rxlist_coefficients = mshape(NA, self.boot_reps, nelem(rxlist))
    matrix ModelBoot.deterministic_coefficients = mshape(NA, self.boot_reps,
                                                         sum(Model.detflags))

    scalar ModelBoot.error_convergence = FALSE
    scalar nloop = 1
    scalar nfailed_estimates = 0

    list xlist_w_lags = get_lags(xlist, self.optimal_lag, self.conditional_model)

    smpl Model.t1 Model.t2      # set sample to the estimation period
    series uhat = Model.uhat    # residuals from the initial model

    list deterlist = list_of_deterministics(Model.detflags)
    list xzlist = deterlist xlist_w_lags rxlist
    matrix xzbeta = build_xzbeta_coeff_vector(Model)

    if self.verbose
        print "Start bootstrap estimation..."
    endif

    smpl -self.optimal_lag ;  # Important to make sure vectors can be cast to series

    loop while nloop <= self.boot_reps
        series innovations = generate_bootstrap_residuals(uhat, self.boot_type)
        series target_boot = varsimA(target, Model.ar_coefficients, xzlist,
                                     xzbeta, innovations, self.optimal_lag)

        # For debugging purposes
        #gnuplot target target_boot --with-lines --time-series --output="output.png"

        bundle ModelTemp = estimate_var(target_boot, xlist_w_lags, rxlist, self, FALSE)
        #ModelBoot.coeff_boot[nloop,] = ModelTemp.coeff'           # TODO: Do we really need all coefficients?
        matrix ar_beta = get_ar_coefficients(ModelTemp)'

        scalar model_is_stable = model_is_stable(ar_beta)
        nfailed_estimates += !model_is_stable ? 1 : 0
        if (nfailed_estimates / self.boot_reps) >= self.stopping_criteria
            print_error_failed_attempts(nfailed_estimates, self.boot_reps)

            ModelBoot.error_convergence = TRUE
            return ModelBoot
        endif

        # Store coefficients
        ModelBoot.ar_coefficients[nloop,] = ar_beta
        ModelBoot.deterministic_coefficients[nloop,] = get_deterministic_coefficients(ModelTemp)'
        # Form per row: x(-1) ~ x(-2) ~ ... ~ x(-pq) ~ z(-1) ~ z(-2) ~ ... ~ z(-pq)
        ModelBoot.xlist_coefficients[nloop,] = vec(get_xlist_coefficients(ModelTemp,
                                                        xlist_w_lags,
                                                        self.vname_xlist))'
        if nelem(rxlist) > 0
            # Form per row: a ~ b ~ ...
            ModelBoot.rxlist_coefficients[nloop,] = \
                vec(get_rxlist_coefficients(ModelTemp, rxlist))'
        endif

        nloop++
    endloop

    if self.verbose
        print "Succesfully finished bootstrap estimation..."
    endif

    return ModelBoot
end function


function series varsimA (const series target,
                         const matrix ar_coeff "Auto-regressive coefficients",
                         const list xlist,
                         const matrix x_coeff "Exogenous coefficients",
                         const series e "innovations",
                         const int p[1::] "Lag length")
    /* Simulate a VAR process. Thankfully borrowed from Jack. */

    matrix my = {target}
    series m = lincomb(xlist, x_coeff)
    scalar T = minr(rows({e}) ~ rows({m}))
    matrix A = ar_coeff'
    if p > 1
        matrix A |= (I(p-1) ~ 0)
    endif

    matrix y0 = mreverse(my[1:p])'
    matrix U = {e + m} ~ zeros(T, p-1)
    matrix S = varsimul(A, U, y0)[, 1]

    if p > 1
        S = my[1:p-1] | S
    endif
    series x = S

    return x
end function


function matrix merge_coeff_longrun_asymp_boot(const matrix coeff_longrun_asym,
                                               const matrix stderr_longrun_asym,
                                               const matrix coeff_longrun_boot,
                                               const matrix stderr_longrun_boot)
    /* Merge asymptotic and bootstrap long-run multipliers. */

    errorif(rows(coeff_longrun_asym) != rows(coeff_longrun_boot),
            "Error: Number of rows in asymptotic and bootstrap long-run multipliers do not match.")
    matrix ret = coeff_longrun_asym ~ stderr_longrun_asym ~ coeff_longrun_boot ~ stderr_longrun_boot

    return ret
end function


function matrix eval_boot_longrun_multipliers (const bundle self,
                                               const matrix multipliers)
    #' Function to evaluate bootstrap long-run multipliers
    #'
    #' This function calculates the mean, median, standard error, and quantiles (2.5% and 97.5%)
    #' of the given multipliers matrix. It returns a matrix with these statistics.
    #'
    #' @param self A bundle containing the model information.
    #' @param multipliers A matrix of bootstrap multipliers.
    #'
    #' @return A matrix with the following columns:
    #'   - Mean: The mean of the multipliers.
    #'   - Median: The median of the multipliers.
    #'   - S.D.: The standard deviation of the multipliers.
    #'   - 2.5%: The 2.5th percentile of the multipliers.
    #'   - 97.5%: The 97.5th percentile of the multipliers.
    #' The rows are labeled with the target variable name and the explanatory variable names.

    matrix lrcoeff_mean = meanc(multipliers)'
    matrix lrcoeff_q025 = quantile(multipliers, 0.025)'
    matrix lrcoeff_median = quantile(multipliers, 0.5)'
    matrix lrcoeff_q975 = quantile(multipliers, 0.975)'
    matrix lrcoeff_stderr = sdc(multipliers)'

    matrix ret = lrcoeff_mean ~ lrcoeff_median ~ lrcoeff_stderr ~ lrcoeff_q025 ~ lrcoeff_q975
    cnameset(ret, defarray("Mean(boot)", "Median(boot)", "S.E.(boot)", "2.5%(boot)", "97.5%(boot)"))
    rlabels = defarray(self.vname_target) + self.vname_xlist
    rnameset(ret, rlabels)

    return ret
end function


function bundle eval_boot_multipliers (const bundle self,
                                       const matrices multipliers,
                                       const scalar alpha)
    #' Evaluates bootstrapped multipliers and returns results in a bundle.
    #'
    #' @param self A bundle containing the necessary parameters and data.
    #' @param multipliers A matrix array of bootstrapped multipliers.
    #' @return A bundle containing the evaluation results for each shock variable.
    #'
    #' This function calculates the mean, median, and confidence intervals
    #' for the bootstrapped multipliers over a specified horizon. The results are stored
    #' in a bundle with matrices for each shock variable.

    #errorif(alpha <= 0.01 || alpha >= 0.99, "alpha must be in (0.01, 0.99).")
    strings shockvars = defarray(self.vname_target) + self.vname_xlist
    matrix horizvector = seq(0, self.max_horizon, 1)'
    bundle results = empty
    strings clabels = defarray("Horizon", "Mean", "Median")
    clabels += sprintf("CI(%g)", 100 * alpha/2)
    clabels += sprintf("CI(%g)", 100 * (1-alpha/2))
    scalar ntmp = nelem(clabels) - 1

    loop foreach i multipliers
        # string matname = sprintf("%s->%s", shockvars[i], self.vname_target)
        string matname = sprintf("%s", shockvars[i])
        matrix mat = mshape(NA, self.max_horizon+1, ntmp)
        mat[,1] = meanr(multipliers[i])'
        mat[,2] = quantile(multipliers[i]', 0.5)'
        mat[,3] = quantile(multipliers[i]', alpha/2)'
        mat[,4] = quantile(multipliers[i]', 1-alpha/2)'
        #mat[,5] = sdc(multipliers[i]')'
        mat = horizvector ~ mat

        cnameset(mat, clabels)
        results["@matname"] = mat
    endloop

    return results
end function


function void print_longrun (const bundle self)

    matrix table_asym = self.coeff_longrun ~ self.stderr_longrun
    matrix model_statistics = get_model_statistics(self.Model)
    strings vnames = defarray(self.vname_target) + self.vname_xlist + rnameget(model_statistics)

    if inbundle(self, "coeff_longrun_boot")
        #matrix table_boot = merge_coeff_longrun_asymp_boot(self.coeff_longrun_boot,
                                                           #self.stderr_longrun_boot)
        # Print mean long-run bootstrap value
        matrix table_boot = self.coeff_longrun_boot[,1] ~ self.stderr_longrun_boot
    endif
    printf "\n\n*********************************************************\n"
    printf "           Long-run multipliers based on ARDL regression\n"
    printf "*********************************************************\n"

    printf "Sample:                 T = %d (%s-%s)\n", self.T, obslabel(self.t1), obslabel(self.t2)
    printf "Dependent variable:     %s\n", self.vname_target
    printf "Deterministics:         %s\n",
        flatten(varnames(list_of_deterministics(self.Model.detflags)), ", ")
    printf "Explanatory variables:  %s\n", flatten(self.vname_xlist, ", ")
    if nelem(self.vname_rxlist) > 0
        printf "Explanatory variables (no lags): %s\n", flatten(self.vname_rxlist, ", ")
    endif
    printf "Lag-length (in levels): %d\n", self.optimal_lag
    #printf "\nShock type: %s\n", get_shocktype(self.cumulated_multipliers)
    if self.boot_reps > 0
        printf "Bootstrap iterations:   %d\n", self.boot_reps
        printf "Bootstrap type:         '%s'\n", get_bootstrap_type(self.boot_type)
    endif

    if exists(table_boot)
        printf "\n  ------------------------------------------------------\n"
        printf "       *** Bootstrap mean long-run effects ***\n"
        modprint table_boot vnames model_statistics
    else
        printf "\n  ------------------------------------------------------\n"
        printf "       *** Asymptotic results (no bootstraping) ***\n"
        modprint table_asym vnames
    endif
    printf "Note: 'SC(d)' and 'ARCH(d)' refer the test on no serial correlation\n"
    printf "      of order 'd' and no ARCH effects of order 'd', respectively.\n"
    printf "*********************************************************\n\n"
end function


function scalar get_rsq (const series target,
                         const matrix uhat)
    /* Compute R-squared statistics. */

    series yhat = target - uhat
    corr target yhat --quiet --uniform
    scalar rsq = $result[1,2]^2

    return rsq
end function

function scalar get_adjusted_rsq (const scalar rsq, const int T, const int df)
    /* Compute the adjusted R-squared statistics. */
    scalar adj_rsq = 1 - (1 - rsq) * (T - 1) / df
    return adj_rsq
end function


function void plot_multiplier (const bundle Model,
                               string vname[null],
                               bundle PlotOpts[null])
    /* Function for plotting dynamic multipliers. */

    set force_decpoint on
    # TODO: add more options for the plot

    if exists(PlotOpts)
        bundle PlotOpts = PlotOpts + plot_defaults()
    else
        bundle PlotOpts = plot_defaults()
    endif

    strings vnames = exists(vname) ? defarray(vname) : \
                     (defarray(Model.vname_target) + Model.vname_xlist)
    strings Plots = empty

    strings clabels = defarray("Mean", "Median")
    clabels += sprintf("LB(%g)", 100 * PlotOpts.alpha/2)
    clabels += sprintf("UB(%g)", 100 * (1-PlotOpts.alpha/2))
    clabels += "Horizon"
    bundle DynamicMultipliers = eval_boot_multipliers(Model,
                                                      Model.multipliers_boot,
                                                      PlotOpts.alpha)

    loop foreach i vnames
        matrix multiplier = DynamicMultipliers["$i"]
        multiplier = multiplier[,2:end] ~ multiplier[,1]  # move horizon to the end
        cnameset(multiplier, clabels)

        # Preparation for plotting
        if !inbundle(PlotOpts, "title")
            string title = get_subplot_title(Model.vname_target, vnames[i],
                                             get_shocktype(Model.cumulated_multipliers))
        endif
        Plots = Plots + doplot(multiplier, PlotOpts, title)
    endloop
    set force_decpoint off

    # Create actual plot
    string filename = exists(PlotOpts.filename) ? PlotOpts.filename : "display"

    if nelem(Plots) == 1
        gridplot Plots --output="@filename"
    else
        gridplot Plots --width=900 --height=600 --fontsize=PlotOpts.fontsize \
            --output="@filename"
    endif

end function

function string doplot (const matrix input,
                        const bundle PlotOpts,
                        const string title)
    /* Function for plotting dynamic multipliers. */

    string ret = empty

    plot input
        options with-lines single-yaxis
        literal set key top right
        printf "set title \"%s\"", title
        printf "set xlabel \"%s\" offset 0,1", PlotOpts.xlabel
        printf "set ylabel \"%s\"", PlotOpts.ylabel
        literal set y2tics
        literal set xtics out offset 0,0.7	# Move xtics closer to the x-axis
        literal set ytics out
        #2) put the border more to the background by applying it
        # only on the left and bottom part and put it and the tics in gray
        printf "set style line 11 lc rgb \"#808080\" lt 1"
        literal set border 3 back ls 11	# get rid of upper + left border
        literal set tics nomirror
        # add a slight grid to make it easier to follow the exact
        # position of the curves
        printf "set style line 12 lc rgb \"#808080\" lt 0 lw 1"
        literal set grid back ls 12
        printf "%s", PlotOpts.gnuplot_cmd
        # Line Styles
        printf "set linetype 1 lc rgb 'black' dt 1 lw %d", PlotOpts.lindewidth
        printf "set linetype 2 lc rgb 'red' dt 2 lw %d", PlotOpts.lindewidth
        printf "set linetype 3 lc rgb 'grey' dt 2 lw %d", PlotOpts.lindewidth
        printf "set linetype 4 lc rgb 'grey' dt 2 lw %d", PlotOpts.lindewidth
    end plot --outbuf=ret

    return ret
end function

function string get_subplot_title (const string target,
                                   const string shock,
                                   const string shocktype)
    /* Create a title for the subplot. */

    string ret = sprintf("%s --> %s  (%s shock)",
                         shock, target, shocktype)

    return ret
end function

function bundle plot_defaults (void)
    /* Default parameter values of plotting dynamic multipliers. */

    bundle self
    #string self.title = ""
    string self.ylabel = ""
    string self.xlabel = "Horizon"
    scalar self.fontsize = 10
    scalar self.lindewidth = 2
    string self.filename = "display"
    string self.gnuplot_cmd = "" # additional gnuplot commands
    scalar self.alpha = 0.1

    return self
end function


############################################################################################################
############################################################################################################


function void ECMinfo (bundle *b)
    /* */


    printf "\n******************************************\n"
    printf "    Error-correction model bootstrap\n"
    printf "    coefficient estimates\n"
    printf "********************************************\n"
    printf "\nError correction coeff. rho (bootstrap values)\n"
    printf "----------------------------------------------\n"
    printf "                 Mean   Median     S.D.\n"
    printf "       rho %10.4f %8.4f %8.4f \n", b.RHO[1], b.RHO[2], b.RHO[3]
    printf "\nLong-run multipliers (bootstrap values)\n"
    printf "----------------------------------------------\n"
    printf "                 Mean   Median     S.D.\n"

    # TODO: get rid of this: create a new array holding y and x series names onl
    scalar varcounter = 1
    loop i=1..(1+b.nx)
        string vname = b.names_variables[varcounter]

        printf "%10s %10.4f %8.4f %8.4f\n", vname, b.LRbeta_@vname[1],
            b.LRbeta_@vname[2], b.LRbeta_@vname[3]

        if i == 1
            varcounter += 1 + b.n_deterministics  # skip "const" and "time"
        else
            varcounter++
        endif
    endloop

    printf "\nBewley's long-run multipliers (2SLS point estimates)\n"
    printf "----------------------------------------------\n"
    printf "               Coeff.     S.D. \n"
    loop i=2..(1+b.nx)
        string vname = b.names_variables[b.n_deterministics + $i]
        printf "%10s %10.4f %8.4f\n", vname, b.LRBew[i-1], b.LRBewSE[i-1]
    endloop
    printf "******************************************\n"
end function


function void LRbeta (bundle *b)
    /* Transform the ARDL level model coefficients in order to obtain the the error-correction coeff. "rho", the long-run multipliers (median bootstrap values) and its bootstrap S.D. */

    # RHO = -[1-SUM_j=1^pq a_{t-j}]
    matrix ybeta = b.BHAT_b[,b.ay:b.ey]
    matrix b.RHO_b = -(1 - sumr(ybeta))
    matrix b.RHO = meanc(b.RHO_b) ~ quantile(b.RHO_b,0.5) ~ sd(b.RHO_b)
    cnameset(b.RHO, "Mean Median SD")

    # Long-run multiplier
    # b_i = (SUM_j=0^pq c_{t-j}) / (1 - rho)
    scalar nvars = b.nx + b.n_deterministics
    matrix xbetas = b.BHAT_b[,b.ax:b.ex]
    scalar in = 1
#    scalar varcounter = 1

    loop i=1..nvars
        string vname = b.names_variables[i]

        if i == 1
            # long-run multiplier of a change in y on y
            matrix b["LRbeta_@vname_b"] = sumr(ybeta) ./ (1 .- sumr(ybeta))
 #           varcounter += 1 + b.n_deterministics # skip "const" and "time"
        else
            if vname == "const" || vname == "column1" || vname == "time"
                out = $i
            else
                out = in + (b.conditional_model + self.max_lag) - 1
                cmat = xbetas[,in:out]
            endif

            # long-run multiplier of a change in x_i on y
            string key = sprintf("LRbeta_%s_b", vname)
            printf "\nkey = %s", key
            b["@key"] = sumr(cmat) ./ (1 .- sumr(ybeta))

            if vname == "const" || vname == "column1" || vname == "time"
                in++
            else
                in += b.conditional_model + self.max_lag
            endif
  #          varcounter++
        endif

        matrix b["LRbeta_@vname"] = mean(b["LRbeta_@vname_b"]) ~ \
                                    quantile(b["LRbeta_@vname_b"], 0.5) ~ \
                                    sd(b["LRbeta_@vname_b"])
        cnameset(b["LRbeta_@vname"], "Mean Median SD")
    endloop
stop
    # Compute LR coeff and SEs using Bewley's IV estim.
    Bewley(&b)

    # Print results
    if b.optsil == ""
        ECMinfo(&b)
    endif

     # Bundle cleanup
     delete b.nx
     delete self.max_lag
     delete b.ey
     delete b.ax
     delete b.ex
     delete b.ay
     delete b.conditional_model
     delete b.cilevel
     delete b.optsil
end function


function void Bewley (bundle *b)
    /* Estimate the long-run multiplier and associated S.E. using the IV approach by Bewley (1979) */

    series target = b.my
    series dY = diff(target)
    list xlist = b.mx
    list Dxlist = diff(xlist)
    list rxlist = mat2list(b.mrx)
    list ListConstTrend = mat2list(b.mConstTrend)

    lags target xlist

    if b.optsil == ""
        print_ardl_info(&b)
    endif

    # Set the regressors
    scalar pmax_exog = self.max_lag - 1

    list Instruments = ListConstTrend target(-1 to -self.max_lag) \
                        xlist(self.max_lagmin to -self.max_lag) rxlist
    list Exogenous = ListConstTrend xlist dY(self.max_lagmin to -pmax_exog) \
                     Dxlist(self.max_lagmin to -pmax_exog) rxlist

    tsls target Exogenous ; Instruments --robust --quiet --no-tests

    scalar ax = 1 + nelem(ListConstTrend)
    scalar ex = ax + nelem(xlist) - 1
    matrix b.LRBew = $coeff[ax:ex]
    matrix b.LRBewSE = $stderr[ax:ex]
 end function


function void ECterm (bundle *b)
    # Compute error correction term (cointegrating relationship)
    # based on bootstrap median long-run coeff.
    # See for the different cases:
    # -->http://blog.eviews.com/2017/04/autoregressive-distributed-lag-ardl.html
    # Case 1: no constant
    # --> ECt = yt - b'x_t
    # Case 2: restricted constant and no trend
    # --> ECt = yt - b'x_t - a0/rho
    # Case 3: unrestricted constant and no trend
    # --> ECt = yt - b'x_t
    # Case 4: unrestricted constant and restricted trend
    # --> ECt = yt - b'x_t - a1/rho
    # Case 5: unrestricted constant and unrestricted trend
    # --> ECt = yt - b'x_t
    # TODO: add constant cases!

    series target = b.my
    list xlist = b.mx
    list ListConstTrend = b.mConstTrend
    scalar nx = nelem(xlist)
    matrix beta = zeros(nx, 1)

    loop i=1..nx
        string vname = b.names_variables[1+$i]
        beta[i] = b.LRbeta_@vname[2]		# based on median value
    endloop

    list LR = xlist
    list lall = target LR
    matrix X = {lall}
    series b.ECM = target - lincomb(LR,beta)

    #setinfo b.ECM --description="EC unrestricted const. "

    if b.with_intercept == 1
        scalar a0 = quantile(b.BHAT_b[,1], 0.5)	 # bootstrap median constant
        # RHO[2] refers to the median
        series b.ECMrc -= a0 / b.RHO[2]	         # Case 2
        #setinfo b.ECMrc --description="EC restricted const."
    endif
end function



function void irfARDL (const matrix mplot,
                       bundle self[null])
    /* Function for plotting dynamic multipliers. */

    if exists(self)
        self = self + plot_defaults()
    else
        bundle self = plot_defaults()
    endif
    string filename = self.filename
    set force_decpoint on

    plot mplot
        options with-lines time-series single-yaxis
        literal set nokey
        printf "set title \"%s\"", self.title
        printf "set xlabel \"%s\" offset 0,1", self.xlabel
        printf "set ylabel \"%s\"", self.ylabel
        literal set y2tics
        literal set xtics out offset 0,0.7	# Move xtics closer to the x-axis
        literal set ytics out
        #2) put the border more to the background by applying it
        # only on the left and bottom part and put it and the tics in gray
        printf "set style line 11 lc rgb \"#808080\" lt 1"
        literal set border 3 back ls 11	# get rid of upper + left border
        literal set tics nomirror
        # add a slight grid to make it easier to follow the exact
        # position of the curves
        printf "set style line 12 lc rgb \"#808080\" lt 0 lw 1"
        literal set grid back ls 12
        # Line Styles
        printf "set linetype 1 lc rgb 'grey' dt 2 lw %d", self.lindewidth
        printf "set linetype 2 lc rgb 'black' lw %d", self.lindewidth
        printf "set linetype 3 lc rgb 'grey' dt 2 lw %d", self.lindewidth
    end plot --output="@filename"

    set force_decpoint off
end function
