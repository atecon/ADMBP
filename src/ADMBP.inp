function void lagselectARDL (bundle *b)
    /* Retrieve optimal lag-length by means of some information lag_criteriaeria. */

    # TODO: make use of "criteria" package which includes AICc

    errorif(self.max_lag == 1, "You have to set the maximum lag-length 'pq' > 1.")

    series y = b.my
    list xlist = b.mx
    list rxlist = b.mrx

    list Xlist = xlist rxlist

    string opt_silent = b.verbose == FALSE ? "--silent" : "--quiet"
    string opt_deterministics = b.with_trend == TRUE ? "--trend" : ""

    var self.max_lag y ; Xlist --lagselect @opt_deterministics @opt_silent
    scalar self.max_lag = iminc($test[,3 + b.lag_criteria])
end function


function scalar model_is_stable (matrix ARcoef)
  /* Check for dynamic stability.
  return: 1 if stable, otherwise 0. */

  matrix ARcoef = vec(ARcoef)
  scalar value = 1 - sumc(ARcoef)

  if -value < -0.00001
      return TRUE
  else
      return FALSE
  endif
end function


function bundle get_defaults (void)
    /* Default parameter values for ARDL estimation. */

    bundle self = empty
    scalar self.max_lag = $pd
    string self.lag_criteria = "AIC"
    scalar self.conditional_model = FALSE
    scalar self.permanent_shock = FALSE
    string self.boot_type = "block"  # "parametric", "non-parametric", "wild uniform", "wild Rademacher", "block-boots."
    scalar self.boot_reps = 999
    scalar self.max_horizon = 12
    scalar self.cilevel = 0.95
    scalar self.verbose = 1
    scalar self.stopping_criteria = 0.2
    # CASES: "nc": no const., "uc": unrestricted const., "rc": restricted const.,
    # "crt": unrest. const + restr. trend, "ct": unrest. const + unrestr. trend
    # This is following gretl's vecm command.
    string self.det_case = "uc"
    scalar self.error = FALSE

    return self
end function

function string get_shocktype (const int permanent_shock)
    /* Get shock type. */
    string shocktype = (permanent_shock == 0) ? "temporary" : "permanent"
    return shocktype
end function

function string get_bootstrap_type (const string boot_type)
    /* Get bootstrap type as full string. */

    if boot_type == "parametric"
        string ret = "parametric"
    elif boot_type == "non-parametric"
        string ret = "non-parametric"
    elif boot_type == "wild-uniform"
        string ret = "wild (uniform)"
    elif boot_type == "wild-rademacher"
        string ret = "wild (Rademacher)"
    elif boot_type == "block"
        string ret = "block-bootstrap"
    endif

    return ret
end function


function scalar missings_exist (const list All)
    /* Check for sample validity. */

    scalar has_missings = FALSE
    scalar nobs = $nobs
    smpl All --no-missing
    scalar nobs_new = $nobs

    if nobs != nobs_new
        printf "Error: Missing values in the sample. Please remove them and try again."
        return TRUE
    else
        return FALSE
    endif
end function

# add function add_varnames()
function void add_varnames (bundle *self,
                            const series target,
                            const list xlist,
                            const list rxlist)
    /* Add variable names to the bundle. */

    self.vname_target = argname(target)
    self.vname_xlist = varnames(xlist)
    self.vname_rxlist = varnames(rxlist)
end function


function bundle est_ardl (const series target "Endogenous in levels",
                          list xlist "Exogenous in levels (lags autom. created)",
                          list rxlist[null] "Exogenous in levels (no lags created)",
                          bundle self[null])
    /* Compute ARDL model regression and dynamic multipliers */

    if exists(self)
        self = self + get_defaults()
    else
        bundle self = get_defaults()
    endif

    # TODO: add a check for any deterministics in xlist and rxlist
    # We will add those

    # TODO: in principle we could internally manage missings, but I think the user
    # should be aware of this and remove them before calling setARDL()

    list xlist = get_lags(xlist, self.max_lag, self.conditional_model)

    smpl +self.max_lag ;
    list All = target xlist rxlist
    scalar err = missings_exist(All)
    if err == TRUE
        self.error = TRUE
        return self
    endif

    add_varnames(&self, target, xlist, rxlist)
    print_ardl_info(self)
    bundle self.Model = estimate_var(target, xlist, rxlist, self)

    scalar model_is_stable = model_is_stable(get_ar_coeffs(self.Model))
    if !model_is_stable
        print "Error: The model is unstable. Re-specify your model and try again."
        self.error = TRUE
        return self
    endif

    print self.Model



    return b
end function

function matrix get_ar_coeffs (const bundle Model)
    /* Get AR coefficients. */
    return vec(Model.A[1,])
end function

function bundle collect_post_est_info (const bundle Model)

    bundle self = empty
    matrix self.ar_coefficients = Model.A[1,]'
    matrix self.uhat = Model.uhat

end function

function list get_lags (const list xlist, const scalar max_lag, const scalar conditional_model)
    /* Create lags for exogenous variables. */

    scalar pqmin = (conditional_model == 1) ? 0 : 1
    list xlist_with_lags = xlist(-pqmin to -max_lag)

    return xlist_with_lags
end function

function bundle estimate_var (const series target "Endogenous in levels",
                              const list xlist "Exogenous in levels",
                              list rxlist[null] "Restricted I0s excl. intercept",
                              const bundle self)
    /* Estimate a 1-dimensional VARX model. */

    list Exog = xlist rxlist

    # TODO: add further options for VARX estimation such as the deterministics
    var self.max_lag target ; xlist rxlist #--quiet

    return $system
end function


function void runARDL (bundle *b)
    /* Actual estimation part. */

    errorif(inbundle(b, "finset"), "Before calling runARDL() a second time, call setARDL() first again.")

    series target = b.my
    list xlist = b.mx
    list rxlist = mat2list(b.mrx)
    list ListConstTrend = mat2list(b.mConstTrend)

    lags target
    string quiet = b.optsil

    if b.verbose
        print_ardl_info(&b)
    endif

    # TODO: In principle we could provide an user-defined matrix before calling runARDL()
    # This could be helpful if want to provide a gappy coefficient matrix with some
    # zeros or fixed parameters (for whatever reasons).

    ols target ListConstTrend target(-1 to -self.max_lag) \
        xlist(self.max_lagmin to -self.max_lag) rxlist @quiet

    # Evaluate stability first
    scalar b.n_coeff = nelem($xlist)
    scalar b.init_consttrend = 1
    scalar b.last_consttrend = b.n_deterministics
    scalar b.ay = b.init_consttrend + 1
    scalar b.ey = b.ay + self.max_lag - 1
    b.ARcoef = $coeff[b.ay:b.ey]
    isstable = model_is_stable(b.ARcoef)
    scalar nvars = 1 + b.n_deterministics + b.nx

    if !isstable
        print "Error: The model is unstable. Re-specify your model and try again"
        b.error = TRUE
    endif

    if b.error == FALSE
        scalar b.ax = b.ey + 1
        scalar b.ex = b.ax + b.nx * (b.conditional_model + self.max_lag) - 1
        # Zcoef: Const.~X1(0 to -pq)~...~Xk(0 to -pq)~rxlist( dummies etc.)
        if nelem(ListConstTrend) > 0  # Deterministics + DL coeff needed for ysim()
            b.Zcoef = $coeff[1:(b.ay-1)] | $coeff[b.ey+1:]
        else
            b.Zcoef = $coeff[b.ey+1:]
        endif

        b.muhat = {$uhat}
        bootARDL(&b)

        # Compute median and confidence intervals of dynamic multipliers for each variable y and xlist.

        # DM_@vname: lower bound ~ median ~ upper bound
        matrix lag_criteria = { b.cilevel / 2, 0.5, (1 - b.cilevel / 2) }

        loop i=1..nvars
            string vname = b.names_variables[$i]
            b["DM_@vname"] = quantile(b.DMraw_@vname', lag_criteria)'
        endloop
        stop
    else
        loop i=1..nvars
            string vname = b.names_variables[$i]
            matrix b.DM_@vname = NA
        endloop
    endif

    b.finset = 1
end function


function series drawE (const bundle b)
    /* Sample from residuals. */

    series uhat = b.muhat

    #uhat = uhat-mean(uhat)	# FIXME: is re-centering needed here??

    if b.boot_type == 0
        series e = normal(0, sd(uhat))	     # parametric bootstrap
    elif b.boot_type == 1
        # draw from estimated residuals by resampling
        # (may suffer from serial correl.)
        series e = resample(uhat)
    elif b.boot_type == 2						# wild uniform
        series e = resample(uhat) * uniform(0,1)
    elif b.boot_type == 3	# Use Rademacher distrib. instead of uniform(0,1)
        series Rad = uniform(0,1)
        Rad = -1 * (Rad <= 0.5) + (Rad > 0.5)
        series e = resample(uhat) * Rad
    elif b.boot_type == 4						# block bootstrap
        series e = SB(b.muhat, 0)
    endif

    return e
end function



function void bootARDL (bundle *b)
    /* Bootsrap estimation. */

    series target = b.my
    list xlist = b.mx
    list rxlist = mat2list(b.mrx)
    list ListConstTrend = mat2list(b.mConstTrend)
    series uhat = b.muhat
    string quiet = b.optsil

    lags target xlist
    list Z = null
    list Z = ListConstTrend xlist(self.max_lagmin to -self.max_lag) rxlist
    matrix Xbeta = b.Zcoef

    # TODO: Make use of matrix array
    loop i=1..(1+b.nx)
        # Store dynamic multipliers of each xlist regressor
        matrix mout$i = zeros(1+b.max_horizon, b.boot_reps)
    endloop

    scalar nloop = 1
    scalar failed = 0
    matrix BHAT_b = zeros(b.boot_reps, b.n_coeff)

    loop while nloop <= b.boot_reps
        series e = drawE(b)
        series y_b = varsimA(target, b.ARcoef, Z, Xbeta, e, self.max_lag)

        lags y_b 1
        list ylist_b = y_b(-1 to -self.max_lag)
        list features = ListConstTrend ylist_b xlist(self.max_lagmin to -self.max_lag) rxlist

        ols y_b features --quiet
        matrix ARcoef_b = $coeff[b.ay:b.ey]
        scalar isstable = model_is_stable(ARcoef_b)

        if !isstable
            failed++
            if (failed / b.boot_reps) >= b.stopping_criteria
                printf "\nError: %d pct. of the bootstrap iterations failed due to instability.\n",\
                    100*b.stopping_criteria
                print "Error: Try to re-specify your model."
                break
            endif
        else
            BHAT_b[nloop,] = $coeff'
            shockbeta = $coeff[b.ax:b.ex]
            shockbeta = mshape(shockbeta, (b.conditional_model + self.max_lag), b.nx)

            loop i=1..(1+b.nx)
                matrix mtmp = zeros(b.max_horizon, 1)

                if i == 1
                    # response of target to a shock in target
                    dmfilt(ARcoef_b, ARcoef_b, b.max_horizon, b.permanent_shock, &mtmp)
                else		# response of y to a shock in x_i
                    dmfilt(ARcoef_b, shockbeta[,i-1], b.max_horizon,
                           b.permanent_shock, &mtmp)
                endif
                mout$i[,nloop] = mtmp
            endloop

            nloop++
        endif
    endloop

    b.BHAT_b = BHAT_b

    scalar varcounter = 1
    scalar nvars =
    loop i=1..(1+b.nx)
        string vname = b.names_variables[$i]
        matrix b.DMraw_@vname = mout$i
    endloop

    # Clean up the bundle
    delete b.nrx
    delete b.lag_criteria
    #delete b.mrx
    delete b.Zcoef
    #delete b.boot_type
    #delete b.permanent_shock
    delete b.ARcoef
    #delete b.addDET
    #delete self.max_lagmin
    delete b.muhat
end function


function series varsimA (const series target,
                       const matrix ARbeta "Coeff. vector of target",
                       const list X "rxlist ~ xlist of exogenous, -pmin to -p",
                       const matrix Xbeta "coeff vector of Xs",
                       const series e "innovations",
                       int p[1::] "Lag length")
    /* Simulate VAR. Thankfully borrowed from Jack. */

    matrix my = {target}

    series m = lincomb(X, Xbeta)
    scalar T = minr(rows({e}) ~ rows({m}))
    matrix A = ARbeta'
    if p > 1
        matrix A |= (I(p-1) ~ 0)
    endif

    matrix y0 = mreverse(my[1:p])'
    matrix U = {e + m} ~ zeros(T, p-1)
    matrix S = varsimul(A, U, y0)[, 1]

    if p > 1
        S = my[1:p-1] | S
    endif

    series x = S

    return x
end function


function void print_ardl_info (const bundle self)
    /* Print ARDL information. */

    printf "\n******************************************\n"
    printf "    ARDL (max-lag = %d) in levels regression\n", self.max_lag
    printf "******************************************\n"
    printf "\nSettings for dynamic multiplier computation\n"

    printf "\nShock type: %s\n", get_shocktype(self.permanent_shock)
    printf "Bootstrap iterations: %d\n", self.boot_reps

    printf "Bootstrap type: %s\n", get_bootstrap_type(self.boot_type)
    printf "Confidence interval (1-alpha): %.2f\n", (1 - self.cilevel)
end function


function void ECMinfo (bundle *b)
    /* */


    printf "\n******************************************\n"
    printf "    Error-correction model bootstrap\n"
    printf "    coefficient estimates\n"
    printf "********************************************\n"
    printf "\nError correction coeff. rho (bootstrap values)\n"
    printf "----------------------------------------------\n"
    printf "                 Mean   Median     S.D.\n"
    printf "       rho %10.4f %8.4f %8.4f \n", b.RHO[1], b.RHO[2], b.RHO[3]
    printf "\nLong-run multipliers (bootstrap values)\n"
    printf "----------------------------------------------\n"
    printf "                 Mean   Median     S.D.\n"

    # TODO: get rid of this: create a new array holding y and x series names onl
    scalar varcounter = 1
    loop i=1..(1+b.nx)
        string vname = b.names_variables[varcounter]

        printf "%10s %10.4f %8.4f %8.4f\n", vname, b.LRbeta_@vname[1],
            b.LRbeta_@vname[2], b.LRbeta_@vname[3]

        if i == 1
            varcounter += 1 + b.n_deterministics  # skip "const" and "time"
        else
            varcounter++
        endif
    endloop

    printf "\nBewley's long-run multipliers (2SLS point estimates)\n"
    printf "----------------------------------------------\n"
    printf "               Coeff.     S.D. \n"
    loop i=2..(1+b.nx)
        string vname = b.names_variables[b.n_deterministics + $i]
        printf "%10s %10.4f %8.4f\n", vname, b.LRBew[i-1], b.LRBewSE[i-1]
    endloop
    printf "******************************************\n"
end function


function void LRbeta (bundle *b)
    /* Transform the ARDL level model coefficients in order to obtain the the error-correction coeff. "rho", the long-run multipliers (median bootstrap values) and its bootstrap S.D. */

    # RHO = -[1-SUM_j=1^pq a_{t-j}]
    matrix ybeta = b.BHAT_b[,b.ay:b.ey]
    matrix b.RHO_b = -(1 - sumr(ybeta))
    matrix b.RHO = meanc(b.RHO_b) ~ quantile(b.RHO_b,0.5) ~ sd(b.RHO_b)
    cnameset(b.RHO, "Mean Median SD")

    # Long-run multiplier
    # b_i = (SUM_j=0^pq c_{t-j}) / (1 - rho)
    scalar nvars = b.nx + b.n_deterministics
    matrix xbetas = b.BHAT_b[,b.ax:b.ex]
    scalar in = 1
#    scalar varcounter = 1

    loop i=1..nvars
        string vname = b.names_variables[i]

        if i == 1
            # long-run multiplier of a change in y on y
            matrix b["LRbeta_@vname_b"] = sumr(ybeta) ./ (1 .- sumr(ybeta))
 #           varcounter += 1 + b.n_deterministics # skip "const" and "time"
        else
            if vname == "const" || vname == "column1" || vname == "time"
                out = $i
            else
                out = in + (b.conditional_model + self.max_lag) - 1
                cmat = xbetas[,in:out]
            endif

            # long-run multiplier of a change in x_i on y
            string key = sprintf("LRbeta_%s_b", vname)
            printf "\nkey = %s", key
            b["@key"] = sumr(cmat) ./ (1 .- sumr(ybeta))

            if vname == "const" || vname == "column1" || vname == "time"
                in++
            else
                in += b.conditional_model + self.max_lag
            endif
  #          varcounter++
        endif

        matrix b["LRbeta_@vname"] = mean(b["LRbeta_@vname_b"]) ~ \
                                    quantile(b["LRbeta_@vname_b"], 0.5) ~ \
                                    sd(b["LRbeta_@vname_b"])
        cnameset(b["LRbeta_@vname"], "Mean Median SD")
    endloop
stop
    # Compute LR coeff and SEs using Bewley's IV estim.
    Bewley(&b)

    # Print results
    if b.optsil == ""
        ECMinfo(&b)
    endif

     # Bundle cleanup
     delete b.nx
     delete self.max_lag
     delete b.ey
     delete b.ax
     delete b.ex
     delete b.ay
     delete b.conditional_model
     delete b.cilevel
     delete b.optsil
end function


function void Bewley (bundle *b)
    /* Estimate the long-run multiplier and associated S.E. using the IV approach by Bewley (1979) */

    series target = b.my
    series dY = diff(target)
    list xlist = b.mx
    list Dxlist = diff(xlist)
    list rxlist = mat2list(b.mrx)
    list ListConstTrend = mat2list(b.mConstTrend)

    lags target xlist

    if b.optsil == ""
        print_ardl_info(&b)
    endif

    # Set the regressors
    scalar pmax_exog = self.max_lag - 1

    list Instruments = ListConstTrend target(-1 to -self.max_lag) \
                        xlist(self.max_lagmin to -self.max_lag) rxlist
    list Exogenous = ListConstTrend xlist dY(self.max_lagmin to -pmax_exog) \
                     Dxlist(self.max_lagmin to -pmax_exog) rxlist

    tsls target Exogenous ; Instruments --robust --quiet --no-tests

    scalar ax = 1 + nelem(ListConstTrend)
    scalar ex = ax + nelem(xlist) - 1
    matrix b.LRBew = $coeff[ax:ex]
    matrix b.LRBewSE = $stderr[ax:ex]
 end function


function void ECterm (bundle *b)
    # Compute error correction term (cointegrating relationship)
    # based on bootstrap median long-run coeff.
    # See for the different cases:
    # -->http://blog.eviews.com/2017/04/autoregressive-distributed-lag-ardl.html
    # Case 1: no constant
    # --> ECt = yt - b'x_t
    # Case 2: restricted constant and no trend
    # --> ECt = yt - b'x_t - a0/rho
    # Case 3: unrestricted constant and no trend
    # --> ECt = yt - b'x_t
    # Case 4: unrestricted constant and restricted trend
    # --> ECt = yt - b'x_t - a1/rho
    # Case 5: unrestricted constant and unrestricted trend
    # --> ECt = yt - b'x_t
    # TODO: add constant cases!

    series target = b.my
    list xlist = b.mx
    list ListConstTrend = b.mConstTrend
    scalar nx = nelem(xlist)
    matrix beta = zeros(nx, 1)

    loop i=1..nx
        string vname = b.names_variables[1+$i]
        beta[i] = b.LRbeta_@vname[2]		# based on median value
    endloop

    list LR = xlist
    list lall = target LR
    matrix X = {lall}
    series b.ECM = target - lincomb(LR,beta)

    #setinfo b.ECM --description="EC unrestricted const. "

    if b.with_intercept == 1
        scalar a0 = quantile(b.BHAT_b[,1], 0.5)	 # bootstrap median constant
        # RHO[2] refers to the median
        series b.ECMrc -= a0 / b.RHO[2]	         # Case 2
        #setinfo b.ECMrc --description="EC restricted const."
    endif
end function


function void dmfilt (const matrix ARcoef,
                      const matrix ycoef,
                      int max_horizon,
                      int permanent_shock,
                      matrix *DM)
    /* Compute dynamic multipliers. */

    matrix impulse = ones(max_horizon + 1, 2)
    impulse[2:,1] = 0
    DM = filter(impulse, ycoef, ARcoef)

    DM = (permanent_shock == 0) ? DM[,1] : DM[,2]
end function


function bundle plot_defaults (void)
    /* Default parameter values of plotting dynamic multipliers. */

    bundle self
    string self.title = ""
    string self.ylabel = ""
    string self.xlabel = "max_horizonon"
    scalar self.fontsize = 10
    scalar self.lindewidth = 1
    string self.filename = "display"

    return self
end function


function void irfARDL (const matrix mplot,
                       bundle self[null])
    /* Function for plotting dynamic multipliers. */

    if exists(self)
        self = self + plot_defaults()
    else
        bundle self = plot_defaults()
    endif
    string filename = self.filename
    set force_decpoint on

    plot mplot
        options with-lines time-series single-yaxis
        literal set nokey
        printf "set title \"%s\"", self.title
        printf "set xlabel \"%s\" offset 0,1", self.xlabel
        printf "set ylabel \"%s\"", self.ylabel
        literal set y2tics
        literal set xtics out offset 0,0.7	# Move xtics closer to the x-axis
        literal set ytics out
        #2) put the border more to the background by applying it
        # only on the left and bottom part and put it and the tics in gray
        printf "set style line 11 lc rgb \"#808080\" lt 1"
        literal set border 3 back ls 11	# get rid of upper + left border
        literal set tics nomirror
        # add a slight grid to make it easier to follow the exact
        # position of the curves
        printf "set style line 12 lc rgb \"#808080\" lt 0 lw 1"
        literal set grid back ls 12
        # Line Styles
        printf "set linetype 1 lc rgb 'grey' dt 2 lw %d", self.lindewidth
        printf "set linetype 2 lc rgb 'black' lw %d", self.lindewidth
        printf "set linetype 3 lc rgb 'grey' dt 2 lw %d", self.lindewidth
    end plot --output="@filename"

    set force_decpoint off
end function
